{
  "name": "vaquita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:daemon": "make -C ../daemon BIN=\"$PWD/src-tauri/bin/vaquitad\" SIGN=\"$VAQUITA_SIGN_IDENTITY\"",
    "tauri": "tauri",
    "test": "vitest run",
    "test:live": "VAQUITA_LIVE=1 vitest run src/lib/live.test.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "@xterm/headless": "6.0.0",
    "happy-dom": "21.0.4",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
