{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vaquita",
  "version": "0.1.0",
  "identifier": "io.github.zeikar.vaquita",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:daemon && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "vaquita",
        "width": 1200,
        "height": 800,
        "theme": "Dark",
        "backgroundColor": "#1e1e1e",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ],
    "macOS": {
      "files": {
        "Helpers/vaquitad.app": "bin/vaquitad.app",
        "Resources/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md"
      },
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RDg2M0EwNzk2NDNENEQKUldSTlBXUjVvR1BZZENzL29QWnVmVXlXanFzSUpPU1h4NzdYUHhCL3BibWhjd3FJdzFMNnJLSkgK",
      "requireSignedVersion": true
    }
  }
}
